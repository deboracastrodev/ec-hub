# Application
APP_ENV=local
APP_DEBUG=true

# Application log (Story 10.4): one JSON line per record on stderr (php -S /
# docker compose logs). Minimum level: a PSR-3 level (debug, info, notice,
# warning, error, critical, alert, emergency) or none to turn logging off.
LOG_LEVEL=info

# Database (MySQL, via docker-compose.yml)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ec_hub
DB_USERNAME=root
DB_PASSWORD=secret

# Redis (via docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_TTL=1800
# Gere com: openssl rand -hex 32. Nunca versione um segredo real.
SESSION_COOKIE_SECRET=
# Retenção do event store (DW-13): cada lista de evento guarda só os N envelopes
# mais recentes; os mais antigos são descartados a cada gravação. Vazio = 5000.
# Precisa ser um inteiro >= 1, senão InvalidArgumentException ao resolver o event store.
EVENT_STORE_MAX_EVENTS_PER_LIST=5000

# Admin panel (Story 8.3): single admin at /admin/products. Both empty (or an
# invalid hash) = panel disabled (fail-closed); the rest of the site is unaffected.
# ADMIN_PASSWORD_HASH is a password_hash() output, never the plain password:
#   php -r "echo password_hash('sua-senha', PASSWORD_DEFAULT), PHP_EOL;"
# Keep the hash in SINGLE quotes here: it contains "$", which double quotes
# (or no quotes) would try to interpolate. Never commit a real credential.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# API authentication -- when "true", GET /api/recommendations requires an
# Authorization header (no token validation beyond presence today)
AUTH_REQUIRED=false

# Recommendation algorithm (Story 8.1): knn (default) or collaborative.
# Any other value throws InvalidArgumentException on every
# GET /api/recommendations (settings load lazily; other routes keep working).
RECOMMENDATION_ALGORITHM=knn

# A/B test between two algorithms (Story 8.2), e.g. "knn,collaborative"
# (first = variant A, second = variant B). Each subject (user_id, else
# session_id) is split 50/50 by hash. Empty or absent turns A/B off.
# Anything other than exactly 2 distinct algorithms throws
# InvalidArgumentException on GET /api/recommendations and /api/ab-tests/results
# (the /metrics panel shows "Comparação indisponível").
RECOMMENDATION_AB_TEST=

# Recommendation fallback tuning (config/recommendation.php reads these as
# defaults; see RuleBasedFallback and GenerateRecommendations)
RECOMMENDATION_FALLBACK_STRATEGY=hybrid
RECOMMENDATION_MIN_PRODUCTS_FOR_ML=5
