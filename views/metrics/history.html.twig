{% extends 'layout/base.html.twig' %}

{% block title %}ec-hub - System Metrics Dashboard{% endblock %}

{% block content %}
    <section class="dashboard" aria-labelledby="metrics-dashboard-title">
        <header class="dashboard__header">
            <p class="dashboard__eyebrow">Vitrine técnica</p>
            <h1 class="dashboard__title" id="metrics-dashboard-title">ec-hub - System Metrics Dashboard</h1>
            <p class="dashboard__description">Acompanhe os eventos registrados na sessão atual.</p>
        </header>

        <div class="dashboard__grid">
            <section class="dashboard__panel dashboard__panel--impact" aria-labelledby="impact-panel-title">
                <header class="dashboard__panel-header">
                    <h2 class="dashboard__panel-title" id="impact-panel-title">Impacto da recomendação</h2>
                    <p class="dashboard__panel-description">Última recomendação registrada nesta sessão.</p>
                </header>

                <dl class="dashboard__metrics" aria-label="Indicadores da recomendação">
                    <div class="dashboard__metric">
                        <dt>Status do ML</dt>
                        <dd>{% if recommendation is null %}ML: indisponível{% elseif recommendation.source == 'ml' %}ML: ativo{% else %}ML: inativo (fallback){% endif %}</dd>
                    </div>
                    <div class="dashboard__metric">
                        <dt>Latência</dt>
                        <dd>{% if recommendation is null %}Latência: —{% else %}{{ recommendation.latency_ms|number_format(2, ',', '.') }} ms{% endif %}</dd>
                    </div>
                    <div class="dashboard__metric">
                        <dt>Confiança média</dt>
                        <dd>{% if recommendation is null or recommendation.count == 0 %}Confiança média: —{% else %}{{ recommendation.avg_confidence|number_format(2, ',', '.') }}%{% endif %}</dd>
                    </div>
                    <div class="dashboard__metric">
                        <dt>Total de eventos</dt>
                        <dd>Total de eventos: {{ total }}</dd>
                    </div>
                    <div class="dashboard__metric">
                        <dt>Recomendações</dt>
                        <dd>{% if recommendation is null %}Recomendações: 0{% else %}Recomendações: {{ recommendation.count }}{% endif %}</dd>
                    </div>
                </dl>
            </section>

            <section class="dashboard__panel dashboard__panel--ab-test" aria-labelledby="ab-test-panel-title">
                <header class="dashboard__panel-header">
                    <h2 class="dashboard__panel-title" id="ab-test-panel-title">Comparação de algoritmos (A/B)</h2>
                    <p class="dashboard__panel-description">Agregado de todas as respostas de recomendação, por algoritmo.</p>
                </header>

                {% if ab_test is null %}
                    <p class="dashboard__empty" role="status">Comparação indisponível.</p>
                {% else %}
                    <p class="dashboard__ab-status" role="status">
                        {% if ab_test.enabled %}
                            Teste A/B: ativo · A = {{ ab_test.variants.A }} · B = {{ ab_test.variants.B }}
                        {% else %}
                            Teste A/B: desligado (um algoritmo por processo)
                        {% endif %}
                    </p>
                    <div class="dashboard__ab-table-wrapper">
                        <table class="dashboard__ab-table">
                            <caption class="dashboard__ab-caption">Métricas por algoritmo</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Algoritmo</th>
                                    <th scope="col">Variante</th>
                                    <th scope="col">Requisições</th>
                                    <th scope="col">Sujeitos únicos</th>
                                    <th scope="col">% itens ML</th>
                                    <th scope="col">Latência média</th>
                                    <th scope="col">Score médio</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in ab_test.algorithms %}
                                    <tr>
                                        <th scope="row">{{ row.algorithm }}</th>
                                        <td>{{ row.variant is null ? '—' : row.variant }}</td>
                                        <td>{{ row.requests }}</td>
                                        <td>{{ row.unique_subjects }}</td>
                                        <td>{% if row.ml_item_rate is null %}—{% else %}{{ row.ml_item_rate|number_format(2, ',', '.') }}%{% endif %}</td>
                                        <td>{% if row.avg_response_time_ms is null %}—{% else %}{{ row.avg_response_time_ms|number_format(2, ',', '.') }} ms{% endif %}</td>
                                        <td>{% if row.avg_score is null %}—{% else %}{{ row.avg_score|number_format(2, ',', '.') }}{% endif %}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <p class="dashboard__ab-export"><a href="/api/ab-tests/results">Exportar resultados (JSON)</a></p>
                {% endif %}
            </section>

            <details class="dashboard__disclosure">
                <summary class="dashboard__disclosure-control">Ver detalhes da sessão atual</summary>
                <section class="dashboard__panel dashboard__panel--session" aria-labelledby="current-session-title">
                    <header class="dashboard__panel-header">
                        <h2 class="dashboard__panel-title" id="current-session-title">Current Session</h2>
                        <p class="dashboard__panel-description">Dados registrados nesta sessão, sem executar uma nova recomendação.</p>
                    </header>
                    <div class="dashboard__session-content">
                        <section aria-labelledby="viewed-products-title">
                            <h3 class="dashboard__session-title" id="viewed-products-title">Produtos visualizados</h3>
                            {% if viewed_products is empty %}
                                <p class="dashboard__empty" role="status">Nenhum produto foi visualizado nesta sessão.</p>
                            {% else %}
                                <ol class="dashboard__product-list" aria-label="Produtos visualizados nesta sessão">
                                    {% for product_id in viewed_products %}<li>Produto: {{ product_id }}</li>{% endfor %}
                                </ol>
                            {% endif %}
                        </section>
                        <section aria-labelledby="recommendation-comparison-title">
                            <h3 class="dashboard__session-title" id="recommendation-comparison-title">Alteração da recomendação</h3>
                            {% if recommendation_comparison.state == 'changed' %}
                                <p class="dashboard__comparison" role="status">A recomendação mudou nesta sessão.</p>
                                <p class="dashboard__comparison-evidence">Anterior: {{ recommendation_comparison.previous|join(', ') }}. Atual: {{ recommendation_comparison.current|join(', ') }}.</p>
                            {% elseif recommendation_comparison.state == 'unchanged' %}
                                <p class="dashboard__comparison" role="status">A recomendação não mudou nesta sessão.</p>
                                <p class="dashboard__comparison-evidence">Recomendação atual: {{ recommendation_comparison.current|join(', ') }}. Recomendação anterior: {{ recommendation_comparison.previous|join(', ') }}.</p>
                            {% else %}
                                <p class="dashboard__empty" role="status">Ainda sem comparação nesta sessão.</p>
                            {% endif %}
                        </section>

                        <details class="dashboard__disclosure dashboard__disclosure--architecture">
                            <summary class="dashboard__disclosure-control">Ver arquitetura técnica</summary>
                            <section class="dashboard__panel dashboard__panel--architecture" aria-labelledby="architecture-visibility-title">
                                <header class="dashboard__panel-header">
                                    <h3 class="dashboard__panel-title" id="architecture-visibility-title">Architecture Visibility</h3>
                                    <p class="dashboard__panel-description">Sinais técnicos observáveis do pipeline de recomendação, sem valores simulados.</p>
                                </header>
                                <dl class="dashboard__metrics" aria-label="Sinais de arquitetura">
                                    <div class="dashboard__metric">
                                        <dt>Redis Pub/Sub</dt>
                                        <dd>
                                            {% if not pubsub.available %}
                                                Redis Pub/Sub: Not available
                                            {% elseif pubsub.connected %}
                                                Redis Pub/Sub: connected · {{ pubsub.published_count }} eventos publicados
                                            {% else %}
                                                Redis Pub/Sub: disconnected
                                            {% endif %}
                                        </dd>
                                    </div>
                                    <div class="dashboard__metric">
                                        <dt>precision@5</dt>
                                        <dd>
                                            {% if quality is null %}
                                                precision@5: indisponível (rode make eval)
                                            {% else %}
                                                precision@5: {{ quality.precisionAt5|number_format(2, ',', '.') }} · medido em {{ quality.measuredAt }}
                                            {% endif %}
                                        </dd>
                                    </div>
                                    <div class="dashboard__metric">
                                        <dt>Cobertura de catálogo@5</dt>
                                        <dd>
                                            {% if quality is null %}
                                                Cobertura de catálogo: indisponível (rode make eval)
                                            {% else %}
                                                Cobertura de catálogo@5: {{ (quality.catalogCoverageAt5 * 100)|number_format(2, ',', '.') }}% · medido em {{ quality.measuredAt }}
                                            {% endif %}
                                        </dd>
                                    </div>
                                    {% if quality is not null %}
                                        <div class="dashboard__metric">
                                            <dt>Contexto da avaliação offline</dt>
                                            <dd>Avaliação offline (make eval): holdout de {{ quality.holdoutSize }} produtos{% if quality.fallbackActivated is not null and quality.fallbackQueries is not null %} · fallback ativado em {{ quality.fallbackActivated }} de {{ quality.fallbackQueries }} consultas{% endif %}</dd>
                                        </div>
                                    {% endif %}
                                    <div class="dashboard__metric">
                                        <dt>Taxa de cold-start (sessão atual)</dt>
                                        <dd>
                                            {% if session_cold_start.state == 'measured' %}
                                                Taxa de cold-start (sessão atual): {{ session_cold_start.fallback_activated }} de {{ session_cold_start.requests }} recomendações ({{ session_cold_start.rate|number_format(2, ',', '.') }}%)
                                            {% elseif session_cold_start.state == 'empty' %}
                                                Taxa de cold-start (sessão atual): nenhuma recomendação nesta sessão
                                            {% else %}
                                                Taxa de cold-start (sessão atual): indisponível
                                            {% endif %}
                                        </dd>
                                    </div>
                                    {% for signal in architecture_signals %}
                                        <div class="dashboard__metric">
                                            <dt>{{ signal.label }}</dt>
                                            <dd>Not available yet ({{ signal.story }})</dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            </section>
                        </details>
                    </div>
                </section>
            </details>

            <section class="dashboard__panel dashboard__panel--history" aria-labelledby="event-history-title">
                <header class="dashboard__panel-header">
                    <h2 class="dashboard__panel-title" id="event-history-title">Histórico de eventos</h2>
                    <p class="dashboard__count" id="event-history-count" aria-live="polite">Total de eventos: {{ total }}</p>
                </header>

                {% if history_unavailable %}
                    <p class="dashboard__empty" role="status">Histórico de eventos indisponível no momento.</p>
                {% elseif events is empty %}
                    <p class="dashboard__empty" role="status">Nenhum evento foi registrado nesta sessão.</p>
                {% else %}
                    <ol class="dashboard__event-list" aria-label="Eventos da sessão, do mais recente ao mais antigo">
                        {% for item in events %}
                            <li class="dashboard__event">
                                <p class="dashboard__event-name">{{ item.event }}</p>
                                <time class="dashboard__event-timestamp" datetime="{{ item.timestamp }}">{{ item.timestamp }}</time>
                                {% if item.product_id is not null %}
                                    <p class="dashboard__event-product">Produto: {{ item.product_id }}</p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}
            </section>
        </div>
    </section>
{% endblock %}
