{
  "name": "ec-hub/app",
  "description": "E-commerce com ML em PHP 8.4 + Clean Architecture",
  "type": "project",
  "require": {
    "php": "^8.4",
    "psr/container": "^2.0",
    "psr/log": "^3.0",
    "vlucas/phpdotenv": "^5.6",
    "rubix/ml": "^2.5",
    "twig/twig": "^3.28"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "friendsofphp/php-cs-fixer": "^3.95",
    "mockery/mockery": "^1.6",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\": "database/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs-fix": "php-cs-fixer fix",
    "cs-check": "php-cs-fixer fix --dry-run",
    "test": "phpunit --coverage-text"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
