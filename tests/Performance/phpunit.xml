<?xml version="1.0" encoding="UTF-8"?>
<!--
  Suíte de performance isolada: fica fora da phpunit.xml raiz para que make test,
  test-no-db e test-full nunca a executem. Roda de propósito contra o stack no ar:
  make test-performance (dentro do container app).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd" bootstrap="../../vendor/autoload.php" beStrictAboutOutputDuringTests="true" failOnSkipped="true" failOnWarning="true" failOnRisky="true" cacheDirectory="../../.phpunit.cache/performance">
  <testsuites>
    <testsuite name="Performance">
      <directory>.</directory>
    </testsuite>
  </testsuites>
  <php>
    <env name="SESSION_COOKIE_SECRET" value="phpunit-only-session-cookie-secret-32" force="true"/>
    <!--
      Igual à phpunit.xml raiz. Sem isso o MemoryGrowthTest (processo isolado)
      loga cada recomendação em JSON no stderr do filho; o PHPUnit só drena o
      stderr depois do stdout, o pipe enche (64 KiB) e o job trava sem timeout.
    -->
    <env name="LOG_LEVEL" value="none" force="true"/>
  </php>
</phpunit>
