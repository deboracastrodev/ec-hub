{% extends 'layout/base.html.twig' %}

{% block title %}{{ meta.title }}{% endblock %}
{% block description %}{{ meta.description }}{% endblock %}
{% block keywords %}{{ meta.keywords }}{% endblock %}
{% block canonical %}{{ meta.canonical }}{% endblock %}

{% block og_title %}{{ meta.og['og:title'] }}{% endblock %}
{% block og_description %}{{ meta.og['og:description'] }}{% endblock %}
{% block og_image %}{{ meta.og['og:image'] }}{% endblock %}
{% block og_url %}{{ meta.og['og:url'] }}{% endblock %}

{% block twitter_title %}{{ meta.twitter['twitter:title'] }}{% endblock %}
{% block twitter_description %}{{ meta.twitter['twitter:description'] }}{% endblock %}
{% block twitter_image %}{{ meta.twitter['twitter:image'] }}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">{{ meta.structured_data|raw }}</script>
{% endblock %}

{% block content %}
<main class="product-detail">
    <nav class="breadcrumb">
        <a href="/products" class="breadcrumb__link">&larr; Voltar para produtos</a>
    </nav>

    <article class="product-detail__card" itemscope itemtype="https://schema.org/Product">
        <header class="product-detail__header">
            <span class="product-detail__category" itemprop="category">
                {{ product.category }}
            </span>
        </header>

        <div class="product-detail__content">
            <figure class="product-detail__image-wrapper">
                <img
                    src="{{ product.image_url }}"
                    alt="{{ product.name }}"
                    class="product-detail__image"
                    itemprop="image"
                    onerror="this.src='https://placehold.co/600x600/FF6B6B/ffffff?text=Sem+imagem'"
                />
            </figure>

            <div class="product-detail__info">
                <h1 class="product-detail__name" itemprop="name">
                    {{ product.name }}
                </h1>

                <p class="product-detail__price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                    <span class="product-detail__price-value" itemprop="price" content="{{ product.price }}">
                        R$ {{ product.price|number_format(2, ',', '.') }}
                    </span>
                    <meta itemprop="priceCurrency" content="BRL" />
                </p>

                {% if product.description %}
                <section class="product-detail__description">
                    <h2 class="product-detail__section-title">Descrição</h2>
                    <div class="product-detail__description-text" itemprop="description">
                        {{ product.description|nl2br }}
                    </div>
                </section>
                {% endif %}

                <div class="product-detail__actions" aria-label="Ações do produto"{% if user_id %} data-user-id="{{ user_id }}"{% endif %}>
                    <button type="button" data-track-product="{{ product.id }}">Registrar interesse</button>
                    <button type="button" data-add-cart="{{ product.id }}">Adicionar ao carrinho</button>
                </div>

                <footer class="product-detail__meta">
                    <time class="product-detail__date" datetime="{{ product.created_at|date('c') }}">
                        Cadastrado em {{ product.created_at|date('d/m/Y') }}
                    </time>
                </footer>
            </div>
        </div>
    </article>
</main>
<script>
document.addEventListener('click', async (event) => {
    const click = event.target.closest('[data-track-product]');
    const cart = event.target.closest('[data-add-cart]');
    if (!click && !cart) return;
    const button = click || cart;
    const productId = button.dataset.trackProduct || button.dataset.addCart;
    const payload = cart ? {product_id: productId, quantity: 1} : {product_id: productId, interaction: 'click'};
    const userId = button.closest('.product-detail__actions').dataset.userId;
    if (userId) payload.user_id = userId;
    try {
        await fetch(cart ? '/api/cart/items' : '/api/events', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload),
            credentials: 'same-origin'
        });
    } catch (_) {}
});
</script>
{% endblock %}
